+    # A student addressed by an initial ("Well done, V.!") is the same student.
+    # Only the initial of a name already found in this document is tagged, and
+    # only where it stands alone: not inside "U.S." or "A.M.", and not a
+    # variable after an operator ("S = 100 - C.").
+    initials = {}  # letter -> (label, confidence); the first label wins
+    for e in sorted(names, key=lambda e: NAME_LABELS.index(e.label)):
+        first = e.text.strip().split()[0] if e.text.strip() else ""
+        if len(first.strip(".")) >= 2 and first[0].isalpha():
+            initials.setdefault(first[0].upper(), (e.label, e.confidence * 0.9))
+    for letter, (label, conf) in initials.items():
+        for m in re.finditer(r"(?<![\w.'’])" + re.escape(letter) + r"\.(?!\w)", text):
+            if (m.start(), m.end()) in seen:
+                continue
+            if INITIAL_MATH_BEFORE_RE.search(text[max(0, m.start() - 12):m.start()]):
+                continue
+            if any(k.start < m.end() and m.start() < k.end for k in out):
+                continue
+            out.append(Entity(label, m.group(), m.start(), m.end(), conf, source="propagated"))
